// Settings shared by every configuration of the iPhone app (tracked in Git).
// Machine- and person-specific values go in Local.xcconfig, which is not tracked:
//   DEVELOPMENT_TEAM = <your team ID>
//   LCMP_BUNDLE_ID = <an app ID only you use>   (only when you sign with a team other than the project's)
//   LCMP_APP_GROUP_ENABLED = YES   (only if your team can use App Groups; the widgets then light while playing)
// Without it the app still builds for the simulator, unsigned.

// The project's app ID, shared with the macOS app (scripts/build-app.py). The widgets, the UI tests and the
// App Group are named after it.
LCMP_BUNDLE_ID = io.github.boyaki-machine.LC-Music-Player
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// The app and the widgets share the transport state through this App Group when it is enabled.
// Without it they build and sign as before, and the widgets show a toggle glyph that never lights.
LCMP_APP_GROUP = group.$(LCMP_BUNDLE_ID)
LCMP_APP_GROUP_ENABLED = NO
LCMP_ENTITLEMENTS_YES = AppGroup.entitlements
LCMP_ENTITLEMENTS_NO =
CODE_SIGN_ENTITLEMENTS = $(LCMP_ENTITLEMENTS_$(LCMP_APP_GROUP_ENABLED))

PRODUCT_NAME = LCMP
PRODUCT_BUNDLE_IDENTIFIER = $(LCMP_BUNDLE_ID)
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
ENABLE_USER_SCRIPT_SANDBOXING = NO
ALWAYS_SEARCH_USER_PATHS = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = LCMPiOS-Info.plist
INFOPLIST_KEY_CFBundleDisplayName = LCMP
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UIStatusBarStyle = UIStatusBarStyleLightContent
INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace = YES
// scripts/ios_resources.py writes the Git-derived version over these after the Info.plist is built.
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

#include? "Local.xcconfig"
